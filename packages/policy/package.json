{
  "name": "@weft/policy",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Weft Policy — provider-neutral permission modes and tool policy evaluation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./loader": {
      "import": {
        "types": "./dist/loader.d.ts",
        "default": "./dist/loader.js"
      },
      "require": {
        "types": "./dist/loader.d.cts",
        "default": "./dist/loader.cjs"
      }
    },
    "./merge": {
      "import": {
        "types": "./dist/merge.d.ts",
        "default": "./dist/merge.js"
      },
      "require": {
        "types": "./dist/merge.d.cts",
        "default": "./dist/merge.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@weft/core": "workspace:*"
  },
  "private": true
}
