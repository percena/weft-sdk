# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage
*.lcov
.nyc_output

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env
.env.*
!.env.example

# Build output
dist
out
.cache

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# pnpm
.pnpm-store

# macOS
.DS_Store

# IDE
.idea/
*.swp
*.swo

# Project-specific / local agent tooling
# Keep operator skills under .claude/skills/<name>/ trackable (e.g. publish-npm).
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/publish-npm/
!.claude/skills/publish-npm/**
.grok
.grok/
.stitch/
.agents
.agents/
.qwen
.qwen/
.cursor
.cursor/
.codex
.codex/

# Internal planning docs (not for OSS)
docs/superpowers/

# Playwright
.playwright
.playwright-cli
.test-results

# Python (demo backends + skill templates)
__pycache__/
*.py[cod]
.venv
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# --- Lattice (generated by lattice-init.sh; merge into repo .gitignore) ---
.lattice/tickets/**/assets/*
!.lattice/tickets/**/assets/.gitkeep
.lattice/.ids/
.lattice/**/.*.tmp
.lattice/lineage/
.lattice/BOARD.md
# Optional: physical worktrees if you override WORKTREE_ROOT in-repo
.worktrees/
# --- end Lattice ---
