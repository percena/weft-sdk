{
  "name": "@weft/host-services",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Weft Host Services \u2014 privileged execution and host-side output governance",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@types/node": "^25.8.0"
  },
  "private": true,
  "dependencies": {
    "@weft/runtime-core": "workspace:*"
  }
}
