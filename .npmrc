# shamefully-hoist=true is REQUIRED: without it, the zod instance resolves to
# two separate copies across the workspace and tsc --noEmit (pnpm check) fails in
# packages/sources/src/sdk-server.ts (previously sdk-stub.ts) with
# `$ZodType`/`ZodType` identity mismatches — `z.ZodTypeAny` resolves to the
# `$ZodType` base from one copy while `instanceof z.ZodOptional` etc. expect the
# `ZodType` class from another. Hoisting collapses both to one physical module.
# Verified 2026-07-10: removing it still breaks `pnpm check` (the breakage moved
# from sdk-stub.ts → sdk-server.ts when the file was renamed; the cause is
# unchanged). `pnpm build` (tsup, non-type-checking) stays green either way.
#
# TODO(shamefully-hoist): remove this once zod is deduped to a single instance
# in the non-hoisted graph. The fix is NOT a version pin — the lockfile already
# resolves every zod to 3.25.76 — it is structural: pnpm isolates the workspace
# zod from the zod pulled in transitively by @anthropic-ai/sdk /
# @modelcontextprotocol/sdk / zod-to-json-schema. Options to evaluate:
#   (a) rework packages/sources/src/sdk-server.ts so its `instanceof` ladder
#       does not cross the $ZodType/ZodType boundary (cast to `z.ZodType` first,
#       or branch on `_def.typeName` instead of `instanceof`); or
#   (b) add a `pnpm.overrides` forcing zod to a single resolution together with
#       `dedupe-peer-dependents` so transitive consumers share the workspace copy.
# Until then keep shamefully-hoist=true.
shamefully-hoist=true
# strict-peer-dependencies=true (set 2026-07-10): tightened from `false` so
# peer mismatches fail install instead of silently shipping. Verified green
# against the current lockfile (no peer warnings).
strict-peer-dependencies=true
