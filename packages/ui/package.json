{
  "name": "@weft/ui",
  "version": "0.1.0",
  "license": "MIT",
  "description": "React streaming chat panel — TurnCard, StreamingMarkdown, event processor",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/styles/index.css",
    "./lib/en-fallback": {
      "import": {
        "types": "./dist/lib/en-fallback.d.ts",
        "default": "./dist/lib/en-fallback.js"
      },
      "require": {
        "types": "./dist/lib/en-fallback.d.cts",
        "default": "./dist/lib/en-fallback.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-css.js",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@shikijs/core": "^3.0.0",
    "@shikijs/engine-javascript": "^3.0.0",
    "@shikijs/langs": "^3.0.0",
    "@shikijs/themes": "^3.0.0",
    "@weft/core": "workspace:*",
    "@weft/timeline": "workspace:*",
    "katex": "^0.16.0",
    "lucide-react": "^0.400.0",
    "motion": "^12.0.0",
    "react-markdown": "^9.0.0",
    "rehype-katex": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zod": "^3.0.0"
  },
  "peerDependencies": {
    "i18next": "^23.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^14.0.0"
  },
  "peerDependenciesMeta": {
    "i18next": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "unified": "^11.0.5"
  },
  "private": true
}
